create or replace package GPROY_ELEL.CONTRATO_tapi
is

type CONTRATO_tapi_rec is record (
TIEMPO_MESES  CONTRATO.TIEMPO_MESES%type
,FECHA_CONTRATO  CONTRATO.FECHA_CONTRATO%type
,ADMINISTRADOR_ID  CONTRATO.ADMINISTRADOR_ID%type
,FISCALIZADOR_ID  CONTRATO.FISCALIZADOR_ID%type
,ANTICIPO_VALOR  CONTRATO.ANTICIPO_VALOR%type
,COMENTARIO  CONTRATO.COMENTARIO%type
,CONTRATISTA_ID  CONTRATO.CONTRATISTA_ID%type
,PROYECTO_ID  CONTRATO.PROYECTO_ID%type
--,EMPRESA_ID  CONTRATO.EMPRESA_ID%type
,USUARIO_ID  CONTRATO.USUARIO_ID%type
,CONTRATO_ID  CONTRATO.CONTRATO_ID%type
,FECHA_FIN  CONTRATO.FECHA_FIN%type
);
type CONTRATO_tapi_tab is table of CONTRATO_tapi_rec;

-- insert
procedure ins (
p_TIEMPO_MESES in CONTRATO.TIEMPO_MESES%type default null 
,p_FECHA_CONTRATO in CONTRATO.FECHA_CONTRATO%type
,p_ADMINISTRADOR_ID in CONTRATO.ADMINISTRADOR_ID%type
,p_FISCALIZADOR_ID in CONTRATO.FISCALIZADOR_ID%type
,p_ANTICIPO_VALOR in CONTRATO.ANTICIPO_VALOR%type default null 
,p_COMENTARIO in CONTRATO.COMENTARIO%type default null 
,p_CONTRATISTA_ID in CONTRATO.CONTRATISTA_ID%type
,p_PROYECTO_ID in CONTRATO.PROYECTO_ID%type
--,p_EMPRESA_ID in CONTRATO.EMPRESA_ID%type
,p_USUARIO_ID in CONTRATO.USUARIO_ID%type
,p_CONTRATO_ID in CONTRATO.CONTRATO_ID%type
,p_FECHA_FIN in CONTRATO.FECHA_FIN%type
);
-- update
procedure upd (
p_TIEMPO_MESES in CONTRATO.TIEMPO_MESES%type default null 
,p_FECHA_CONTRATO in CONTRATO.FECHA_CONTRATO%type
,p_ADMINISTRADOR_ID in CONTRATO.ADMINISTRADOR_ID%type
,p_FISCALIZADOR_ID in CONTRATO.FISCALIZADOR_ID%type
,p_ANTICIPO_VALOR in CONTRATO.ANTICIPO_VALOR%type default null 
,p_COMENTARIO in CONTRATO.COMENTARIO%type default null 
,p_CONTRATISTA_ID in CONTRATO.CONTRATISTA_ID%type
,p_PROYECTO_ID in CONTRATO.PROYECTO_ID%type
--,p_EMPRESA_ID in CONTRATO.EMPRESA_ID%type
,p_USUARIO_ID in CONTRATO.USUARIO_ID%type
,p_CONTRATO_ID in CONTRATO.CONTRATO_ID%type
,p_FECHA_FIN in CONTRATO.FECHA_FIN%type
);
-- delete
procedure del (
p_CONTRATO_ID in CONTRATO.CONTRATO_ID%type
);
--Cerrar contrato iunilateralmente por inconformidad del cliente.
procedure cerrar_contrato_unilateral(p_contrato_id CONTRATO.CONTRATO_ID%TYPE,
                                     p_causa varchar2);
end CONTRATO_tapi;